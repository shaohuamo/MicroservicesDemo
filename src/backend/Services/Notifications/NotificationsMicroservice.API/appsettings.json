{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnection": "Host=$POSTGRES_HOST;Port=$POSTGRES_PORT;Database=$POSTGRES_DATABASE;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD"
  },
  "POSTGRES": {
    "Host": "localhost",
    "Port": "5432",
    "Database": "notificationsdatabase",
    "User": "postgres",
    "Password": "admin",
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "MaxRetryAttempts": 10,
    "InitialDelaySeconds": 2,
    "MaxDelaySeconds": 30,
    "NetworkRecoveryIntervalSeconds": 10
  },
  "ProductOperations": {
    "Exchange": "products.operations",
    "RoutingKey": "products.operation.completed",
    "Queue": "notifications.products.operations",
    "DeadLetterExchange": "products.operations.dlx",
    "DeadLetterQueue": "notifications.products.operations.dead-letter",
    "PrefetchCount": 20
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ConnectRetry": 5,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AbortOnConnectFail": false,
    "InitialReconnectDelayMilliseconds": 500,
    "MaxReconnectDelayMilliseconds": 5000
  },
  "Delivery": {
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "LeaseSeconds": 30,
    "SseAckDeadlineSeconds": 5,
    "MaxSseAttempts": 2,
    "MaxAttempts": 5,
    "InitialRetryDelaySeconds": 2,
    "MaxRetryDelaySeconds": 60,
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 60
  },
  "ResendEmail": {
    "ApiToken": "",
    "From": "",
    "EnglishSubject": "Product operation result",
    "ChineseSubject": "产品操作结果"
  }
}
