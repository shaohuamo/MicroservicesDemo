{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/products",
      "DownstreamPathTemplate": "/api/products",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put"
      ],

      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [
          "products-api"
        ]
      },

      "RateLimitOptions": {
        "Limit": 100,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "ClientWhitelist": [],
        "ClientIdHeader": "Client-Id"
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/products/{everything}",
      "DownstreamPathTemplate": "/api/products/{everything}",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get",
        "Delete"
      ],

      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [
          "products-api"
        ]
      },

      "RateLimitOptions": {
        "Limit": 100,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "ClientWhitelist": [],
        "ClientIdHeader": "Client-Id"
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notifications",
      "DownstreamPathTemplate": "/api/notifications",
      "UpstreamScheme": "http",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "notifications-microservice-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "notifications-api" ]
      },
      "RateLimitOptions": {
        "Limit": 100,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "ClientWhitelist": [],
        "ClientIdHeader": "Client-Id"
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notifications/{everything}",
      "DownstreamPathTemplate": "/api/notifications/{everything}",
      "UpstreamScheme": "http",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "notifications-microservice-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "notifications-api" ]
      },
      "RateLimitOptions": {
        "Limit": 100,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "ClientWhitelist": [],
        "ClientIdHeader": "Client-Id"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway-service:8080"
  }
}
