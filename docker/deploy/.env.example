# Image tag configuration for docker-compose deployment
# By default, all images use 'latest' if these variables are not set

# Shared IdentityServer/Admin Web absolute refresh token lifetime (seconds).
REFRESH_TOKEN_ABSOLUTE_LIFETIME_SECONDS=2592000

# Products Microservice image tag
PRODUCTS_IMAGE_TAG=latest

# API Gateway image tag
APIGATEWAY_IMAGE_TAG=latest

# IdentityServer image tag
IDENTITYSERVER_IMAGE_TAG=latest

# Notifications Microservice image tag
NOTIFICATIONS_IMAGE_TAG=latest

# Admin Web (frontend) image tag
ADMINWEB_IMAGE_TAG=latest

# Public URLs and secrets used by IdentityServer and Admin Web
FRONTEND_PUBLIC_URL=http://localhost:3000
IDENTITYSERVER_PUBLIC_URL=http://localhost:8085
IDENTITYSERVER_FRONTEND_CLIENT_SECRET=change-me
AUTH_SECRET=change-me

# The same proof key ID and Base64 key must be supplied to Admin Web and API Gateway.
AUTH_GATEWAY_PROOF_KEY_ID=v1
AUTH_GATEWAY_PROOF_KEY=replace-with-a-base64-encoded-32-byte-random-key

# Resend email settings for IdentityServer email confirmation.
# RESEND_EMAIL_API_TOKEN should come from a secret store in real deployments.
# RESEND_EMAIL_FROM must use a Resend verified domain before real delivery.
RESEND_EMAIL_API_TOKEN=
RESEND_EMAIL_FROM=MicroservicesDemo <verify@auth.250669.xyz>
RESEND_EMAIL_CONFIRMATION_SUBJECT=Confirm your MicroservicesDemo account

# Set to false to bypass register/resend throttling during deployment tests.
EMAIL_VERIFICATION_RATE_LIMIT_ENABLED=true

# Production IdentityServer signing certificate.
# Generate/provision a real .pfx certificate outside git and mount it read-only into the container.
IDENTITYSERVER_SIGNING_CERTIFICATE_HOST_PATH=../../configs/identityserver/signing.pfx
IDENTITYSERVER_SIGNING_CERTIFICATE_PATH=/https/identityserver-signing.pfx
IDENTITYSERVER_SIGNING_CERTIFICATE_PASSWORD=change-me

# PostgreSQL credentials used by Admin Web
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Optional IdentityServer seed user. Keep disabled unless explicitly needed.
IDENTITYSERVER_SEED_USER_ENABLED=false
IDENTITYSERVER_SEED_USER_NAME=
IDENTITYSERVER_SEED_USER_EMAIL=
IDENTITYSERVER_SEED_USER_PASSWORD=

# Example: Pin to a specific CI build
# Set all variables to the same sha tag to ensure all services are from the same build:
# PRODUCTS_IMAGE_TAG=sha-a1b2c3d4e5f6
# APIGATEWAY_IMAGE_TAG=sha-a1b2c3d4e5f6
# IDENTITYSERVER_IMAGE_TAG=sha-a1b2c3d4e5f6
# NOTIFICATIONS_IMAGE_TAG=sha-a1b2c3d4e5f6
# ADMINWEB_IMAGE_TAG=sha-a1b2c3d4e5f6
#
# Then start with:
# docker compose -f docker-compose.yml --env-file .env up -d
