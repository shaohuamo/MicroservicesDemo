# Development environment variables for docker compose
# Shared IdentityServer/Admin Web absolute refresh token lifetime (seconds).
REFRESH_TOKEN_ABSOLUTE_LIFETIME_SECONDS=2592000

# Shared development-only proof key for Admin Web and API Gateway.
AUTH_GATEWAY_PROOF_KEY_ID=v1
AUTH_GATEWAY_PROOF_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional local IdentityServer seed user. Use non-production credentials only.
IDENTITYSERVER_SEED_USER_NAME=local-admin
IDENTITYSERVER_SEED_USER_EMAIL=local-admin@example.com
IDENTITYSERVER_SEED_USER_PASSWORD=change-me-local-only

# Resend email settings for IdentityServer email confirmation.
# RESEND_EMAIL_FROM must use a Resend verified domain before real delivery.
RESEND_EMAIL_API_TOKEN=
RESEND_EMAIL_FROM=MicroservicesDemo <verify@auth.250669.xyz>
RESEND_EMAIL_CONFIRMATION_SUBJECT=Confirm your MicroservicesDemo account

# Set to false to bypass register/resend throttling during local testing.
EMAIL_VERIFICATION_RATE_LIMIT_ENABLED=true

# Start development environment with:
# docker compose --env-file docker/dev/.env -f docker/dev/docker-compose.yml up
