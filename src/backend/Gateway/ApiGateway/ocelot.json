{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/products",
      "DownstreamPathTemplate": "/api/products",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put"
      ],

      "ServiceName": "productservice",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [
          "products-api"
        ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/products/{everything}",
      "DownstreamPathTemplate": "/api/products/{everything}",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get",
        "Delete"
      ],

      "ServiceName": "productservice",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [
          "products-api"
        ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/consul/agent/services",
      "DownstreamPathTemplate": "/v1/agent/services",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get"
      ],

      "DownstreamHostAndPorts": [
        {
          "Host": "consul",
          "Port": 8500
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/consul/health/service/{serviceName}",
      "DownstreamPathTemplate": "/v1/health/service/{serviceName}",

      "UpstreamScheme": "http",
      "DownstreamScheme": "http",

      "UpstreamHttpMethod": [
        "Get"
      ],

      "DownstreamHostAndPorts": [
        {
          "Host": "consul",
          "Port": 8500
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/notifications",
      "DownstreamPathTemplate": "/api/notifications",
      "UpstreamScheme": "http",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "Get" ],
      "ServiceName": "notificationservice",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "notifications-api" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notifications/{everything}",
      "DownstreamPathTemplate": "/api/notifications/{everything}",
      "UpstreamScheme": "http",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "ServiceName": "notificationservice",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "notifications-api" ]
      }
    }
  ], // required section
  "GlobalConfiguration": { // required 
    "BaseUrl": "http://apigateway8080", //apigateway is host name of apigateway's container——http://localhost:5085
    "ServiceDiscoveryProvider": {
      "Host": "consul", // Consul container's host name——localhost
      "Port": 8500, // Consul API port
      "Type": "Consul", // type of service discovery
      "PollingInterval": 10000, // roundrobin internal
      "ConfigurationKey": "Ocelot_A"
    }
  }
}
